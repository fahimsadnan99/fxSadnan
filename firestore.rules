rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = signed in as the one admin account (same email as ADMIN_EMAIL in src/config.js).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@fxsadnan.com';
    }

    match /posts/{postId} {
      // Anyone can read published posts; only the admin sees drafts or writes.
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
